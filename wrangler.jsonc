// ═══════════════════════════════════════════════════════════════════════════
//  這個檔案裡有 4 個值是「你的」，不是範例作者的
//
//    name           Worker 名稱，決定你的網址              可以沿用
//    database_name  D1 資料庫名稱                          可以沿用
//    bucket_name    R2 bucket 名稱                         可以沿用
//    database_id    你帳號裡那個資料庫的 UUID          ← 一定要換掉
//
//  前三個可以直接沿用預設值 —— 資源名稱是各自 Cloudflare 帳號內部的，
//  不同人之間不會撞名。真正非改不可的只有 database_id，
//  因為那是 Cloudflare 幫你建立資料庫時才產生的編號。
//
//  想換成自己的名字也可以，這個檔案是唯一要動的地方：
//  npm script 用的是 binding 名稱（DB、BUCKET），不會跟著資源名稱跑。
//  唯一的例外是「建立資源」的那兩行指令，你本來就得自己打名字：
//
//      npx wrangler d1 create <你的 database_name>
//      npx wrangler r2 bucket create <你的 bucket_name>
//
//  忘記換 database_id 的話，npm run deploy 會先擋下來並告訴你（見 npm run check）。
//
// ───────────────────────────────────────────────────────────────────────────
//  不想把自己的值寫進這個檔案（例如 repo 要保持佔位字串給學生看）？
//  在 Cloudflare 後台 Settings → Build →「Build variables and secrets」設定，
//  部署時 scripts/apply-build-vars.mjs 會把它們填進來：
//
//      組建變數              覆寫這個欄位
//      ──────────────────    ─────────────────────
//      CF_WORKER_NAME    →   name
//      D1_DATABASE_NAME  →   database_name
//      D1_DATABASE_ID    →   database_id
//      R2_BUCKET_NAME    →   bucket_name
//      GOOGLE_CLIENT_ID  →   vars.GOOGLE_CLIENT_ID
//
//  沒設的欄位就沿用這個檔案裡原本的值。這幾個變數只在 Workers Builds 生效，
//  在你自己電腦上不會改動這個檔案。
// ═══════════════════════════════════════════════════════════════════════════

{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ── 你的 ── 部署後網址會是 https://cf-todo-demo.<你的子網域>.workers.dev
  // 組建變數 CF_WORKER_NAME 可覆寫
  "name": "cf-todo-demo",

  // Worker 程式進入點。這支 Worker 只負責 /api/* 的請求。
  "main": "src/index.js",

  // 決定 Workers 執行環境的行為版本。新專案填當下日期即可，之後不要隨意往前調。
  "compatibility_date": "2026-01-01",

  // ── 靜態資產：public/ 底下的 HTML / CSS / JS ────────────────────────────
  // 有了這段設定，同一個 Worker 就同時是「靜態網站主機」和「API 伺服器」。
  "assets": {
    "directory": "./public",

    // 在 Worker 程式裡用 env.ASSETS 存取這些檔案。
    "binding": "ASSETS",

    // 只有 /api/* 會先交給 Worker；其餘路徑（/、/styles.css、/app.js）
    // 直接由 Cloudflare 邊緣節點送出，Worker 完全不會執行 —— 不佔用呼叫次數。
    // 這就是頁面上 EDGE TRACE 第一列標示「未經 Worker」的原因。
    "run_worker_first": ["/api/*"],

    // 找不到的檔案就回 404。本專案只有單頁，不需要 SPA fallback。
    "not_found_handling": "none"
  },

  // ── 環境變數 ──────────────────────────────────────────────────────────
  // vars 不是機密：內容會被打包進 Worker，前端也拿得到。
  // 真正的機密請用 `npx wrangler secret put`，不要寫在這裡。
  "vars": {
    // Google Cloud Console 建立的 OAuth 2.0「用戶端 ID」。
    // 只需要用戶端 ID，本專案不使用用戶端密鑰。
    // 留空的話，頁面會改用本機示範帳號，一樣能完整操作 D1 與 R2。
    //
    // 組建變數 GOOGLE_CLIENT_ID 可覆寫。
    // 注意：直接在後台的 Variables and Secrets 設同名變數是沒用的 ——
    // 只要這一行還在，每次部署都會用這裡的值把它蓋回去
    //（wrangler 預設會先清空 vars 再套用設定檔，除非加 --keep-vars）。
    "GOOGLE_CLIENT_ID": ""
  },

  // ── D1：存待辦文字（SQLite）────────────────────────────────────────────
  "d1_databases": [
    {
      // binding 是程式裡的 env.DB，也是 npm script 用的代號。不要改。
      "binding": "DB",

      // ── 你的 ── 改了這裡，建立資料庫的指令也要用同一個名字
      // 組建變數 D1_DATABASE_NAME 可覆寫
      "database_name": "todo-db",

      // ── 你的，一定要換 ──
      // 執行 `npx wrangler d1 create todo-db`，把它印出來的 UUID 貼在這裡。
      // 資料庫已經建好的話，用 `npx wrangler d1 list` 也查得到。
      // 組建變數 D1_DATABASE_ID 可覆寫（就不必把真值寫進這個檔案）
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE"
    }
  ],

  // ── R2：存待辦的附圖（物件儲存）────────────────────────────────────────
  "r2_buckets": [
    {
      // binding 是程式裡的 env.BUCKET。不要改。
      "binding": "BUCKET",

      // ── 你的 ── R2 沒有 id，用名稱對應就行。
      // 用 `npx wrangler r2 bucket create todo-images` 建立。
      // 組建變數 R2_BUCKET_NAME 可覆寫
      "bucket_name": "todo-images"
    }
  ],

  // 開啟 Workers Logs，之後可在 Cloudflare 後台查看即時日誌與錯誤。
  "observability": {
    "enabled": true
  }
}
